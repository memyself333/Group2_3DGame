  m_Script: {fileID: 11500000, guid: ff0d82623321fa54b9e2111f8662b1f0, type: 3}
  m_Name: IntroC1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: Are you behaving in there, prisoner?
  - speaker: {fileID: 11400000, guid: acc9eb1cf5a20f94bb38876b48cc38e2, type: 2}
    text: 'And If I do not? You will throw me in here to rot again? '
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: There are worse things than being left to rot, prisoner.
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: (What should I ask?)
  options:
  - optionText: Who are you loyal to?
    nextDialogue: {fileID: 11400000, guid: 536f20fb21feda84492ba1b5968e7f65, type: 2}
  - optionText: What crime did you commit?
    nextDialogue: {fileID: 11400000, guid: 205090cd187c17b4383a68fece89770f, type: 2}
  - optionText: Do you repent for your sins?
    nextDialogue: {fileID: 11400000, guid: f47539733c732e646b9c0b02d8c3426a, type: 2}
  - optionText: Who do you worship?
    nextDialogue: {fileID: 11400000, guid: fdb1504509e93ad41a69d1d0440af39d, type: 2}
  requiredConvos: []
