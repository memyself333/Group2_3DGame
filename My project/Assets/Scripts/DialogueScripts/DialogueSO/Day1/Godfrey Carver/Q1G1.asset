  m_Script: {fileID: 11500000, guid: ff0d82623321fa54b9e2111f8662b1f0, type: 3}
  m_Name: Q1G1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: Which kingdom do you owe your loyalty to?
  - speaker: {fileID: 11400000, guid: 329decddb3e896447a7d75201dd4f13b, type: 2}
    text: The one and only King Carver, my father, who will not allow this treason
      to continue.
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: Hah! Humorous that you believe your father even cares to see your face.
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: (What else should I ask?)
  options:
  - optionText: What crime did you commit?
    nextDialogue: {fileID: 11400000, guid: 6dedbedcee5751047b3b7804f9d483e4, type: 2}
  - optionText: Do you repent for your sins?
    nextDialogue: {fileID: 11400000, guid: 22586fe4d928e0f42849dd9a4ecd346f, type: 2}
  - optionText: Who do you worship?
    nextDialogue: {fileID: 11400000, guid: 2942cc4a64fe3344e845c4f073bda1ec, type: 2}
  requiredConvos: []
