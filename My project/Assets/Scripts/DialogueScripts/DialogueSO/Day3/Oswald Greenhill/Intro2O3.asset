  m_Script: {fileID: 11500000, guid: ff0d82623321fa54b9e2111f8662b1f0, type: 3}
  m_Name: Intro2O3
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: Hello again, prisoner.
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: I have some questions for you.
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: (What should I ask?)
  options:
  - optionText: Will you stand in front of the church court?
    nextDialogue: {fileID: 11400000, guid: 9ad7ef790682d864588303abbb9c86ee, type: 2}
  - optionText: Who were your accomplices?
    nextDialogue: {fileID: 11400000, guid: 1169feead12ded2488d2ffb4958bcfca, type: 2}
  - optionText: Who will bring your food?
    nextDialogue: {fileID: 11400000, guid: 218a6fdb068103340bcb820f89fb0543, type: 2}
  - optionText: Was your crime the work of the Devil?
    nextDialogue: {fileID: 11400000, guid: bd3fb002066b0e445bf66d6543d22ce1, type: 2}
  requiredConvos:
  - {fileID: 11400000, guid: 550a2aaf7d5c3544fae05e3c51e269ae, type: 2}
