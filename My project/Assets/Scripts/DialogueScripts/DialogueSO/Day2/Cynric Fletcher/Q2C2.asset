  m_Script: {fileID: 11500000, guid: ff0d82623321fa54b9e2111f8662b1f0, type: 3}
  m_Name: Q2C2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: "Who were your accomplices in the crime you\u2019ve committed?"
  - speaker: {fileID: 11400000, guid: acc9eb1cf5a20f94bb38876b48cc38e2, type: 2}
    text: You dare to ask the names of those you have done away with?
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: You are the last of this rebellion due for extermination.
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: (What else should I ask?)
  options:
  - optionText: Will you stand in front of the church court?
    nextDialogue: {fileID: 11400000, guid: ef312ff9cf9f3e440918d1a4745ece14, type: 2}
  - optionText: Who will bring your food?
    nextDialogue: {fileID: 11400000, guid: ac5cefec185dc0c42a611a2a3a6810ea, type: 2}
  - optionText: Was your crime the work of the Devil?
    nextDialogue: {fileID: 11400000, guid: 7db0b5037aae45245b1515d7dc738e32, type: 2}
  requiredConvos: []
