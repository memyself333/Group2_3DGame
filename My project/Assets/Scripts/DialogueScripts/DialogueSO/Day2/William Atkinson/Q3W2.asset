  m_Script: {fileID: 11500000, guid: ff0d82623321fa54b9e2111f8662b1f0, type: 3}
  m_Name: Q3W2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: Who will bring you food today?
  - speaker: {fileID: 11400000, guid: 7975f33c4f73b844ab43e8c752f00326, type: 2}
    text: I do not need to eat those rations. I have my meal right in front of me.
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: "\u2026Y-You can\u2019t escape\u2026right?"
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: (What else should I ask?)
  options:
  - optionText: ill you stand in front of the church court?
    nextDialogue: {fileID: 11400000, guid: 9a954a70a0fd7cb4fa89a4d9617ae3ab, type: 2}
  - optionText: Who were your accomplices?
    nextDialogue: {fileID: 11400000, guid: 852716af2161c974aa71b79e486b2407, type: 2}
  - optionText: Was your crime the work of the Devil?
    nextDialogue: {fileID: 11400000, guid: 720f9af4371afbe4f863227149fc1ec1, type: 2}
  requiredConvos: []
