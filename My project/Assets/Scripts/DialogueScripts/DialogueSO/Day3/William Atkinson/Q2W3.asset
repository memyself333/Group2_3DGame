  m_Script: {fileID: 11500000, guid: ff0d82623321fa54b9e2111f8662b1f0, type: 3}
  m_Name: Q2W3
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: "Who were your accomplices in the crime you\u2019ve committed?"
  - speaker: {fileID: 11400000, guid: 7975f33c4f73b844ab43e8c752f00326, type: 2}
    text: Everyone is an accomplice, if everyone sins.
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: I have not and never will sin. K-Keep those dirty words out your mouth.
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: (What else should I ask?)
  options:
  - optionText: Will you stand in front of the church court?
    nextDialogue: {fileID: 11400000, guid: 9215fc193669cbe44a37ad8d138d46f2, type: 2}
  - optionText: Who will bring your food?
    nextDialogue: {fileID: 11400000, guid: 0651386fb9181e8479fcfc4e53e512d3, type: 2}
  - optionText: Was your crime the work of the Devil?
    nextDialogue: {fileID: 11400000, guid: 2c6c5cc171cecfe4890a59b84f94a0e0, type: 2}
  requiredConvos: []
