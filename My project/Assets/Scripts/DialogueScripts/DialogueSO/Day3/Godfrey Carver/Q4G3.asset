  m_Script: {fileID: 11500000, guid: ff0d82623321fa54b9e2111f8662b1f0, type: 3}
  m_Name: Q4G3
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: Who made you commit this act, was it the Devil?
  - speaker: {fileID: 11400000, guid: 329decddb3e896447a7d75201dd4f13b, type: 2}
    text: No such thing as the devil, only I, the bringer of destiny.
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: Now, I doubt that the church will be on your side.
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: (What else should I ask?)
  options:
  - optionText: Will you stand in front of the church court?
    nextDialogue: {fileID: 11400000, guid: 9f1f558acf2a6f04a92a4f4a3320d03c, type: 2}
  - optionText: Who were your accomplices?
    nextDialogue: {fileID: 11400000, guid: e4429baf24f95e248b8225d67483431c, type: 2}
  - optionText: Who will bring your food?
    nextDialogue: {fileID: 11400000, guid: bd62ad738aab75542b1425d651839b85, type: 2}
  requiredConvos: []
