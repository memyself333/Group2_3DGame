  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ff0d82623321fa54b9e2111f8662b1f0, type: 3}
  m_Name: Q4O2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: Who made you commit this act, was it the Devil?
  - speaker: {fileID: 11400000, guid: 3f6288731ce029749915fd04743cd09d, type: 2}
    text: The devil was cast down by his own family. Maybe we are one in the same
      in that regard.
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: I see, it is too late for you, the whispers of the Devil have already entered
      your mind.
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: (What else should I ask?)
  options:
  - optionText: Will you stand in front of the church court?
    nextDialogue: {fileID: 11400000, guid: fa48940fd75755e4c9e25a3b95ed84b9, type: 2}
  - optionText: Who were your accomplices?
    nextDialogue: {fileID: 11400000, guid: 3ea8b57369a10114da40b7ddabc567f0, type: 2}
  - optionText: Who will bring your food?
    nextDialogue: {fileID: 11400000, guid: 81fd609ab18ef5543b41a81a8441298a, type: 2}
  requiredConvos: []
