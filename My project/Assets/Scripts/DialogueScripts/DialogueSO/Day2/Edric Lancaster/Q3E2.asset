  lines:
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: Do you have any relatives?
  - speaker: {fileID: 11400000, guid: ff554c407b93d574e84f5f1618aba610, type: 2}
    text: I had my brothers in arms. They continue to fight.
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: "I would not be so sure. The king\u2019s men have squashed many rats as
      of late."
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: (What else should I ask?)
  options:
  - optionText: Who do you worship?
    nextDialogue: {fileID: 11400000, guid: 4c8604debbc2e2a4abba130b7e29edb5, type: 2}
  - optionText: Who are you loyal to?
    nextDialogue: {fileID: 11400000, guid: 26660ece72be6034b99e51731d6611ee, type: 2}
  - optionText: Do you have any relations?
    nextDialogue: {fileID: 11400000}
