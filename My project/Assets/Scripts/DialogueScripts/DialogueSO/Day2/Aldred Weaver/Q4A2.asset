  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ff0d82623321fa54b9e2111f8662b1f0, type: 3}
  m_Name: Q4A2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: Who made you commit this act, was it the Devil?
  - speaker: {fileID: 11400000, guid: 9422cbed940533746945e8f2853fd658, type: 2}
    text: "I have done wrong sir, but I-I rebuke the influence of Satan\u2019s red
      hands. "
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: I do not know of a man that has not been tempted by his desires - ridiculous
      to think you of all people should be above it.
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: (What else should I ask?)
  options:
  - optionText: Will you stand in front of the church court?
    nextDialogue: {fileID: 11400000, guid: 1eb927200a1d28e488c6578a5a922154, type: 2}
  - optionText: Who were your accomplices?
    nextDialogue: {fileID: 11400000, guid: 7649826941393814295ef19029ae692a, type: 2}
  - optionText: Who will bring your food?
    nextDialogue: {fileID: 11400000, guid: b62dfc4dd68a96245a7aeaae70cebd75, type: 2}
  requiredConvos: []
