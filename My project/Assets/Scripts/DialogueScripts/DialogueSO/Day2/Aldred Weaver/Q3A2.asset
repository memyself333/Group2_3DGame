  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ff0d82623321fa54b9e2111f8662b1f0, type: 3}
  m_Name: Q3A2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: Do you have nay blood-relatives?
  - speaker: {fileID: 11400000, guid: 9422cbed940533746945e8f2853fd658, type: 2}
    text: My Gods are the world itself. The wind, the grass, the water.
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: We shall see how much your so-called-Gods will be of help in the end.
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: (What else should I ask?)
  options:
  - optionText: Who do you worship?
    nextDialogue: {fileID: 11400000, guid: 1eb927200a1d28e488c6578a5a922154, type: 2}
  - optionText: Who are you loyal to?
    nextDialogue: {fileID: 11400000, guid: 7649826941393814295ef19029ae692a, type: 2}
  - optionText: Do you have any relations?
    nextDialogue: {fileID: 11400000}
  requiredConvos: []
