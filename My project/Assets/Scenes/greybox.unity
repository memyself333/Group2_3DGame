  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Hark, fellow keeper,



    I trust this message finds thee well, and
    that thou art prepared to undertake thine duty of overseeing the prisoners of
    Castle Scarwood.



    Thine task shall require thee navigating to the prison
    cells found underneath thine office, asking the prisoners questions related to
    their behavior, and crossing off whether or not their responses were appropriate
    or not on the page found attached to their cells.



    After interrogating
    all the prisoners, thou shalt return to thine office where thou will determine
    which prisoners shall be sent for execution, and which ones shall remain. Thou
    shalt then document the names of the prisoners who shall be sent to execution
    on the page nailed to your office wall.



    May fortune favor thou, fellow
    jailor, and may the Almighty keep thee in His watchful gaze.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
