  m_Script: {fileID: 11500000, guid: ff0d82623321fa54b9e2111f8662b1f0, type: 3}
  m_Name: Q2W2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: Which kingdom do you owe your loyalty to?
  - speaker: {fileID: 11400000, guid: 7975f33c4f73b844ab43e8c752f00326, type: 2}
    text: The kingdom of Belial, zealot.
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: May God spite you down for uttering his name.
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: (What else should I ask?)
  options:
  - optionText: Who do you worship?
    nextDialogue: {fileID: 11400000, guid: 9a954a70a0fd7cb4fa89a4d9617ae3ab, type: 2}
  - optionText: Who are you loyal to?
    nextDialogue: {fileID: 11400000}
  - optionText: Do you have any relations?
    nextDialogue: {fileID: 11400000, guid: 58e604684cf10d447bd7a62768596fc1, type: 2}
  requiredConvos: []
