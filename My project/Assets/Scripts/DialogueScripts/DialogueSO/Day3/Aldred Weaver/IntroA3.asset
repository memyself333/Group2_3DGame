  m_Script: {fileID: 11500000, guid: ff0d82623321fa54b9e2111f8662b1f0, type: 3}
  m_Name: IntroA3
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: ...Prisoner.
  - speaker: {fileID: 11400000, guid: 9422cbed940533746945e8f2853fd658, type: 2}
    text: You look tired today jailor, are you feeling well?
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: I...I shalt not speak to you about it.
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: (What should I ask?)
  options:
  - optionText: Do you work with the Devil?
    nextDialogue: {fileID: 11400000, guid: 7ce4ec2e196fd574a8ba2611bc91bd17, type: 2}
  - optionText: Am I safe?
    nextDialogue: {fileID: 11400000, guid: 87d373c8a4723ac4f9a19ac246566393, type: 2}
  - optionText: Do you think you're evil?
    nextDialogue: {fileID: 11400000, guid: cd4bc5c82f38b8c40aa34b05377abb26, type: 2}
  requiredConvos: []
