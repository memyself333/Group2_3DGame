  m_Script: {fileID: 11500000, guid: ff0d82623321fa54b9e2111f8662b1f0, type: 3}
  m_Name: Q2W
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: Do you have any next of kin?
  - speaker: {fileID: 11400000, guid: 7975f33c4f73b844ab43e8c752f00326, type: 2}
    text: My mother, yet she is frail and will not live for many more years.
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: We will be sure to deal with this issue.
  - speaker: {fileID: 11400000, guid: d02f92ecb714b5a4daa6daa630cf91df, type: 2}
    text: (What else should I ask?)
  options:
  - optionText: Have you been eating?
    nextDialogue: {fileID: 11400000, guid: 5a488e8cf8945c244bde42405e4f266c, type: 2}
  - optionText: Do you repent for your sins?
    nextDialogue: {fileID: 11400000, guid: 02e454a273ed54f479dc84a2de5663f8, type: 2}
  - optionText: Who do you worship?
    nextDialogue: {fileID: 11400000, guid: 51059be4525630c459ce1f6f10f8c1fb, type: 2}
  requiredConvos: []
